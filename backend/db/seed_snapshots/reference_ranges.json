{
  "version": "2026-11-15",
  "description": "Single source of clinical reference ranges. Fixed limits follow the metric_catalog contract: outside nominal = INFO, outside warning = WARNING, below critical_min or at/above critical_threshold = CRITICAL. Personal drift (z-score) is only judged for metrics with a 'drift' direction, never with a spread smaller than 'drift_sd_floor' (measurement repeatability).",
  "sources": {
    "pulse": "MedlinePlus - Pulse (adults 60-100 bpm; well-trained athletes 40-60 bpm)",
    "blood_pressure": "MedlinePlus - Blood pressure measurement (normal <120/<80; elevated 120-129/<80; stage 1 130-139 or 80-89; stage 2 >=140 or >=90; crisis >180/>120)",
    "body_temperature": "MedlinePlus - Body temperature norms (36.5-37.3 C)",
    "pulse_oximetry": "WHO Pulse Oximetry Training Manual; Habitable Atmosphere technical brief (normal 95-100%, acceptable 93-94%, mild hypoxemia 91-92%, moderate 86-90%; habitat rest 96-99%)",
    "glucose": "MedlinePlus - Blood glucose test (fasting 70-99 mg/dL; random 70-139; 2 h postprandial <140; HbA1c <5.7%)",
    "bmi": "Spaceflight Human-System Standard Vol. 2 (2025) - pre-flight BMI optimal 18.5-24.9, acceptable 25.0-27.9, critical <18.0 or >=28.0; post-flight mass retention >95% optimal, 90-95% acceptable, <90% critical",
    "muscle": "Reduced Cardiorespiratory and Musculoskeletal Fitness risk report; Counteracting Bone and Muscle Loss in Microgravity (up to 20% loss in 5-11 days without exercise; 10-12% over 4-6 months with standard exercise; adult male 28-36 kg, female 18-24 kg)",
    "bone": "npj Microgravity systematic review and meta-analysis of bone loss in space travelers (missions >28 days: pelvis/lumbar spine -6.2%, lower limbs -5.4%, thorax/upper limbs -0.7%, skull +2.2%)",
    "sleep": "NCBI Bookshelf NBK526132 Physiology, Sleep Stages; National Sleep Foundation - What is Sleep Quality (7-9 h; N1 ~5%, N2 45-55%, N3 15-25%, REM 20-25%; sleep HR 45-65 bpm; RMSSD >=40 ms; respiratory rate 12-15)",
    "stress": "Frontiers in Public Health 2017 - Heart Rate Variability Metrics and Norms; MedlinePlus - Cortisol test (RMSSD 30-100+ ms healthy; <20-30 ms sustained = acute stress)",
    "nutrition": "Dietary Guidelines for Americans 2020-2025; AJCN energy requirements; Mifflin-St Jeor basal metabolic rate",
    "hydration": "HPRC - Urine color charts; GSSI - Urine markers for hydration (color 1-3 hydrated, 4-6 hypohydrated, >=7 dehydrated; intake male 2.5-3.7 L, female 2.0-2.7 L, 30-35 mL/kg; plasma osmolality 275-295 mOsm/kg)",
    "exercise": "Exercise countermeasures special publication SP-20250000273 (short <=14 d: 3 days/week x 20 min; long >=180 d: 6-7 days/week x 30 min, keep >=80% of pre-flight VO2 max)",
    "cabin": "Natural and Induced Environments Vol. 2 (performance zone 20-25 C and 30-60% RH; reference extremes 18 C/75% and 27 C/25%)",
    "radiation": "Radiation Protection technical brief; The Human Body in Space (background 2.4-3.0 mSv/year; public 1 mSv/year; occupational 20 mSv/year)",
    "ocular": "Spaceflight Associated Neuro-ocular Syndrome clinical brief (exams pre-flight, day 30, day 90, 30 days before return and post-flight; acuity, Amsler grid, symptoms, fundoscopy, OCT)",
    "cabin_air": "Habitable Atmosphere technical brief; crew design targets (CO2 below 3.2 mmHg, alert at 4.0 mmHg, physician at 5.0 mmHg)"
  },
